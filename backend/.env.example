# ==============================================================================
# MCU Alumni Portal — Backend Microservices Environment Template
# Copy this file to backend/.env and fill in your actual credentials.
# NEVER commit your real backend/.env file to GitHub!
# ==============================================================================

# Unified Microservices Server Port
PORT=8000

# Microservices Gateway & Service Ports
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ALUMNI_SERVICE_PORT=8002
EVENTS_SERVICE_PORT=8003
JOBS_SERVICE_PORT=8004
ENGAGEMENT_SERVICE_PORT=8005

# Service URLs used by API Gateway
AUTH_SERVICE_URL=http://localhost:8001
ALUMNI_SERVICE_URL=http://localhost:8002
EVENTS_SERVICE_URL=http://localhost:8003
JOBS_SERVICE_URL=http://localhost:8004
ENGAGEMENT_SERVICE_URL=http://localhost:8005

FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mcu_alumni_db

# Security & Session JWT Secret
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Real Email SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="MCU Alumni Portal <your_email@gmail.com>"
