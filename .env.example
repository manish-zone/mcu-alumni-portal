# ==============================================================================
# MCU Alumni Portal — Root Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to GitHub!
# ==============================================================================

# Server Port & Origin
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mcu_alumni_db

# Security & Session JWT Secret
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key

# Google OAuth 2.0 Client ID (Web Application)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Real Email SMTP Settings (For Password Reset OTP & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="MCU Alumni Portal <your_email@gmail.com>"
