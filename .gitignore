# ==============================================================================
# MCU Alumni Portal — Enterprise Git Ignore Configuration
# (React 19 + Vite 6 Frontend | Go Microservices Backend | MySQL Enterprise)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Local Configurations & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
*.env.*
*.local
**/.env
**/.env.*
backend/.env
backend/.env.*

# Keep safe, sanitised documentation templates tracked in Git
!.env.example
!backend/.env.example

